      "id": "file:udp_server.py",
      "type": "file",
      "name": "udp_server.py",
      "filePath": "udp_server.py",
      "summary": "Implements versioned UDP JSON RPC with exclusive session leases, authentication, request deduplication and monotonic control sequencing. Routes requests to MotorService, publishes snapshots, and requests a stop when the socket worker fails or the server closes.",
      "tags": [
        "udp-server",
        "rpc",
        "authentication",
        "deduplication",
        "telemetry"
      ],
      "complexity": "moderate"
    },
